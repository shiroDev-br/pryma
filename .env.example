# Get your free API key at https://www.omdbapi.com/apikey.aspx
# Required for movie posters and metadata in the Hero section
OMDB_API_KEY=yourkeyhere

# Camada de dados: 'mock' (catálogo sintético, sem backend) ou 'live' (FastAPI)
DATA_MODE=mock
# URL interna do FastAPI (usada apenas pelo proxy Nitro em DATA_MODE=live)
API_BASE_URL=http://localhost:8000

# API-Football v3 (https://www.api-football.com/documentation-v3) — só no servidor,
# nunca exposta ao browser. O proxy /api/football/* usa esta chave.
FOOTBALL_API_KEY=yourkeyhere
# Fuso usado para calcular o dia da janela de jogos (hoje/amanhã).
FOOTBALL_TIMEZONE=America/Sao_Paulo